# LexiRAG configuration
# Copy to .env (the setup scripts do this for you and generate a database password).
# Every variable below is read by the backend, docker-compose.yml and the scripts.
# Never commit .env.

# ── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Database (PostgreSQL + pgvector via Docker Compose) ──────
# 5433 avoids clashing with a natively installed PostgreSQL on 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=lexirag
POSTGRES_USER=lexirag
POSTGRES_PASSWORD=change-me
# Optional full override. When set, the POSTGRES_* values above are ignored by the backend.
# Example: postgresql+psycopg://lexirag:secret@127.0.0.1:5433/lexirag
DATABASE_URL=

# ── Backend API ──────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=5173
# Read by Vite at startup (only VITE_* variables reach the browser).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Document storage ─────────────────────────────────────────
# Relative paths resolve against the project root.
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=50

# ── Document processing ─────────────────────────────────────
# Queue uploads for extraction/chunking/embedding automatically.
AUTO_PROCESS_UPLOADS=true
# Tesseract OCR for scanned pages (optional). Leave TESSERACT_CMD empty if tesseract is on PATH.
OCR_ENABLED=true
TESSERACT_CMD=
OCR_LANGUAGES=eng+hin+ben+mar+pan+fra
OCR_DPI=300
OCR_MIN_TEXT_CHARS=25
MAX_PAGES=2000

# ── Chunking (tokens of the embedding model's tokenizer) ────
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=120
CHUNK_MIN_TOKENS=120

# ── Local models (downloaded once with: python -m app.cli download-models) ──
# Empty = default Hugging Face cache (~/.cache/huggingface). Needs ~4.5 GB.
MODEL_CACHE_DIR=
# false = never download implicitly; a missing model produces an actionable error.
MODELS_ALLOW_DOWNLOAD=false
# auto | cpu | cuda | mps   (auto uses CUDA when available, otherwise CPU)
MODEL_DEVICE=auto
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Retrieval ───────────────────────────────────────────────
RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_BM25_TOP_K=30
RETRIEVAL_RRF_K=60
RERANK_CANDIDATES=16
RETRIEVAL_FINAL_TOP_K=6

# ── Answer generation ───────────────────────────────────────
# none | ollama | anthropic | gemini. Without a provider, search works but answering is disabled.
LLM_PROVIDER=none
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
# Optional path to a file that replaces the built-in grounded-answer system prompt.
LLM_SYSTEM_PROMPT_PATH=
# Ollama (local): install from https://ollama.com, then `ollama pull <model>`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Anthropic: an API key from console.anthropic.com (Claude Code access does not provide one)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Google Gemini: an API key from aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
